{
  "manifest_version": 3,
  "name": "otto",
  "description": "Fills logins, 2FA codes and cards from your otto vault into the right site when your agent asks, without the agent seeing them.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": ["nativeMessaging", "scripting", "tabs", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "otto",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/toolbar-light-16.png", "24": "icons/toolbar-light-24.png", "32": "icons/toolbar-light-32.png" }
  },
  "icons": { "16": "icons/tile-16.png", "32": "icons/tile-32.png", "48": "icons/tile-48.png", "128": "icons/tile-128.png" }
}
